 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "RISK-.YYYY.-.#####",
   "default": "RISK-.YYYY.-.#####",
   "hidden": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Risk Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Link",
   "label": "Category",
   "options": "Risk Category",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "objective",
   "fieldtype": "Select",
   "label": "Objective",
   "options": "Strategic\nOperations\nReporting\nCompliance",
   "default": "Operations",
   "reqd": 1,
   "description": "The one objective the risk most threatens"
  },
  {
   "fieldname": "fraud_impact",
   "fieldtype": "Select",
   "label": "Fraud Impact",
   "options": "N/A\nFinancial Fraud\nNon-Financial Fraud",
   "default": "N/A"
  },
  {
   "fieldname": "risk_owner",
   "fieldtype": "Link",
   "label": "Risk Owner",
   "options": "User",
   "in_standard_filter": 1,
   "description": "Accountable for the response and for keeping the risk current"
  },
  {
   "fieldname": "cb_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Identified\nAssessed\nTreating\nMonitoring\nClosed",
   "default": "Identified",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "identified_on",
   "fieldtype": "Date",
   "label": "Identified On",
   "default": "Today"
  },
  {
   "fieldname": "machine",
   "fieldtype": "Link",
   "label": "Machine",
   "options": "Machine"
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location or Process Area"
  },
  {
   "fieldname": "template",
   "fieldtype": "Link",
   "label": "From Template",
   "options": "Risk Template",
   "read_only": 1
  },
  {
   "fieldname": "sb_statement",
   "fieldtype": "Section Break",
   "label": "Risk Statement"
  },
  {
   "fieldname": "risk_statement",
   "fieldtype": "Small Text",
   "label": "Risk Statement",
   "reqd": 1,
   "description": "A potential event, not an issue that has already happened: \"If <event>, then <all the impacts>\""
  },
  {
   "fieldname": "context",
   "fieldtype": "Small Text",
   "label": "Causes and Context"
  },
  {
   "fieldname": "sb_inherent",
   "fieldtype": "Section Break",
   "label": "Inherent Risk",
   "description": "Before any action is taken. Impact: 1 Very Low to 5 Very High. Likelihood: 1 under 5%, 2 5-25%, 3 26-49%, 4 50-74%, 5 75% or more"
  },
  {
   "fieldname": "inherent_impact",
   "fieldtype": "Int",
   "label": "Inherent Impact (1-5)",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "fieldname": "inherent_likelihood",
   "fieldtype": "Int",
   "label": "Inherent Likelihood (1-5)",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "fieldname": "cb_inherent",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "inherent_score",
   "fieldtype": "Int",
   "label": "Inherent Score",
   "read_only": 1
  },
  {
   "fieldname": "inherent_rating",
   "fieldtype": "Data",
   "label": "Inherent Rating",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sb_response",
   "fieldtype": "Section Break",
   "label": "Current Response"
  },
  {
   "fieldname": "response",
   "fieldtype": "Select",
   "label": "Response",
   "options": "\nAccept\nAvoid\nReduce\nTransfer\nShare",
   "description": "Accept: no action. Avoid: stop the activity. Reduce: controls lower the likelihood or impact. Transfer or Share: another organization takes on all or part of it"
  },
  {
   "fieldname": "transfer_to",
   "fieldtype": "Data",
   "label": "Transferred or Shared With",
   "depends_on": "eval:[\"Transfer\",\"Share\"].includes(doc.response)"
  },
  {
   "fieldname": "cb_response",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "current_actions",
   "fieldtype": "Small Text",
   "label": "Current Actions"
  },
  {
   "fieldname": "sb_controls",
   "fieldtype": "Section Break",
   "label": "Controls",
   "description": "Most effective first: elimination, substitution, engineering controls, administrative controls and work practices, then PPE"
  },
  {
   "fieldname": "controls",
   "fieldtype": "Table",
   "label": "Controls",
   "options": "Risk Control"
  },
  {
   "fieldname": "strongest_control",
   "fieldtype": "Data",
   "label": "Strongest Control in Place",
   "read_only": 1
  },
  {
   "fieldname": "controls_in_place",
   "fieldtype": "Int",
   "label": "Controls in Place",
   "read_only": 1
  },
  {
   "fieldname": "sb_residual",
   "fieldtype": "Section Break",
   "label": "Residual Risk",
   "description": "After the current response. Never higher than the inherent rating; empty means no reduction"
  },
  {
   "fieldname": "residual_impact",
   "fieldtype": "Int",
   "label": "Residual Impact (1-5)",
   "non_negative": 1
  },
  {
   "fieldname": "residual_likelihood",
   "fieldtype": "Int",
   "label": "Residual Likelihood (1-5)",
   "non_negative": 1
  },
  {
