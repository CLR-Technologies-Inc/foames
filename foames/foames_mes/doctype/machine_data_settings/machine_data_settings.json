 "fields": [
  {
   "fieldname": "sb_webhook",
   "fieldtype": "Section Break",
   "label": "Webhook"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "description": "Shared secret for the HMAC-SHA256 signature on POSTs to foames.foames_mes.api.ingest_machine_events"
  },
  {
   "fieldname": "signature_tolerance_seconds",
   "fieldtype": "Int",
   "label": "Signature Tolerance (s)",
   "default": "300"
  },
  {
   "fieldname": "sb_mqtt",
   "fieldtype": "Section Break",
   "label": "MQTT",
   "description": "The broker below serves both the plain MQTT gateway and the Sparkplug B gateway"
  },
  {
   "fieldname": "mqtt_enabled",
   "fieldtype": "Check",
   "label": "MQTT Enabled",
   "default": "0"
  },
  {
   "fieldname": "mqtt_broker",
   "fieldtype": "Data",
   "label": "Broker Host"
  },
  {
   "fieldname": "mqtt_port",
   "fieldtype": "Int",
   "label": "Port",
   "default": "1883"
  },
  {
   "fieldname": "mqtt_tls",
   "fieldtype": "Check",
   "label": "Use TLS",
   "default": "0"
  },
  {
   "fieldname": "cb_mqtt",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mqtt_username",
   "fieldtype": "Data",
   "label": "Username"
  },
  {
   "fieldname": "mqtt_password",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "fieldname": "mqtt_topic_prefix",
   "fieldtype": "Data",
   "label": "Topic Prefix",
   "default": "foames",
   "description": "Gateway subscribes to <prefix>/<machine source id>/<event type>"
  },
  {
   "fieldname": "sb_sparkplug",
   "fieldtype": "Section Break",
   "label": "Sparkplug B (Ignition)"
  },
  {
   "fieldname": "sparkplug_enabled",
   "fieldtype": "Check",
   "label": "Sparkplug B Enabled",
   "default": "0",
   "description": "Subscribe to spBv1.0 messages on the MQTT broker above, as published by Ignition's MQTT Transmission module"
  },
  {
   "fieldname": "sparkplug_group_id",
   "fieldtype": "Data",
   "label": "Group ID",
   "description": "Only this Sparkplug group; leave empty for all groups"
  },
  {
   "fieldname": "sb_opcua",
   "fieldtype": "Section Break",
   "label": "OPC UA"
  },
  {
   "fieldname": "opcua_enabled",
   "fieldtype": "Check",
   "label": "OPC UA Enabled",
   "default": "0"
  },
  {
   "fieldname": "opcua_endpoint",
   "fieldtype": "Data",
   "label": "Endpoint URL",
   "description": "opc.tcp://host:4840"
  },
  {
   "fieldname": "opcua_poll_seconds",
   "fieldtype": "Int",
   "label": "Poll Interval (s)",
   "default": "5"
  },
  {
   "fieldname": "cb_opcua",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opcua_username",
   "fieldtype": "Data",
   "label": "Username"
  },
  {
   "fieldname": "opcua_password",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "fieldname": "node_map",
   "fieldtype": "Table",
   "label": "Node and Metric Map",
   "options": "Machine Node Map",
   "description": "What each OPC UA node or Sparkplug B metric means. Sparkplug metrics that follow the naming convention in docs/ignition.md need no row"
  },
  {
   "fieldname": "sb_opcua_security",
   "fieldtype": "Section Break",
   "label": "OPC UA Security",
   "collapsible": 0,
   "description": "Message security for the OPC UA gateway. Sign and SignAndEncrypt need a client certificate and private key that the OPC UA server trusts. See docs/machine-data.md"
  },
  {
   "fieldname": "opcua_security_mode",
   "fieldtype": "Select",
   "label": "Message Security Mode",
   "options": "None\nSign\nSignAndEncrypt",
   "default": "None",
   "description": "SignAndEncrypt is recommended. None sends everything, including the username and password, in the clear unless the server encrypts the user token"
  },
  {
   "fieldname": "opcua_security_policy",
   "fieldtype": "Select",
   "label": "Security Policy",
   "options": "Basic256Sha256\nAes128_Sha256_RsaOaep\nAes256_Sha256_RsaPss",
   "default": "Basic256Sha256",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "mandatory_depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'"
  },
  {
   "fieldname": "opcua_application_uri",
   "fieldtype": "Data",
   "label": "Client Application URI",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "Must equal the URI in the client certificate's subjectAltName, for example urn:example.com:foames:opcua-gateway. Leave empty to use the gateway library's default"
  },
  {
   "fieldname": "cb_opcua_security",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opcua_client_certificate",
   "fieldtype": "Attach",
   "label": "Client Certificate",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "mandatory_depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "X.509 certificate (DER or PEM) the gateway presents to the server"
  },
  {
   "fieldname": "opcua_private_key",
   "fieldtype": "Attach",
   "label": "Client Private Key",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "mandatory_depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "PEM or DER private key for the client certificate. Must be uploaded as a private file"
  },
  {
   "fieldname": "opcua_private_key_password",
   "fieldtype": "Password",
   "label": "Private Key Passphrase",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "Only if the private key is encrypted"
  },
  {
   "fieldname": "opcua_server_certificate",
   "fieldtype": "Attach",
   "label": "Server Certificate",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "Optional. The server's certificate (DER or PEM). When set, the gateway uses it instead of the one the server offers, which pins the server"
  },
  {
   "fieldname": "opcua_trusted_certificates",
   "fieldtype": "Attach",
   "label": "Trusted Certificates",
   "depends_on": "eval:doc.opcua_security_mode && doc.opcua_security_mode != 'None'",
   "description": "Optional. A PEM bundle (or one DER file) of the certificates the server's certificate must be, or chain to: the plant CA, or the server certificates themselves. The gateway then refuses a server whose certificate is unknown, expired or carries another application URI. Needs asyncua 1.1 or later"
  },
  {
   "fieldname": "sb_health",
   "fieldtype": "Section Break",
   "label": "Health"
  },
  {
   "fieldname": "stale_after_minutes",
   "fieldtype": "Int",
   "label": "Mark Machine Unknown After (min)",
   "default": "15",
   "description": "A machine with no event for this long is marked Unknown by the scheduler"
  },
  {
   "fieldname": "sb_spc",
   "fieldtype": "Section Break",
   "label": "Statistical Process Control",
   "description": "Control charts over Measurement events. The hourly suggestion run judges the last hours' readings against limits set by the readings before them, and raises an Agent Suggestion for each chart and rule that signals."
  },
  {
   "fieldname": "spc_enabled",
   "fieldtype": "Check",
   "label": "SPC Suggestions Enabled",
   "default": "1"
  },
  {
   "fieldname": "spc_rule_set",
   "fieldtype": "Select",
   "label": "Run Rules",
   "options": "Nelson\nWestern Electric",
   "default": "Nelson"
  },
  {
   "fieldname": "spc_subgroup_size",
   "fieldtype": "Int",
   "label": "X-bar R Subgroup Size",
   "default": "0",
   "description": "Consecutive readings per subgroup, 2 to 25. 0 charts individuals (I-MR) only."
  },
  {
   "fieldname": "cb_spc",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "spc_baseline_days",
   "fieldtype": "Int",
   "label": "Baseline Window (days)",
   "default": "7"
  },
  {
   "fieldname": "spc_recent_hours",
   "fieldtype": "Int",
   "label": "Judge Readings From the Last (hours)",
   "default": "2"
  },
  {
   "fieldname": "spc_min_baseline_points",
   "fieldtype": "Int",
   "label": "Minimum Baseline Readings",
   "default": "20"
  }
 ],
