# Copy to .env and adjust. Every value has the same default in docker-compose.yml.

# Frappe branch to init the bench from: version-15 or version-16.
FRAPPE_BRANCH=version-16
# Leave empty for plain Frappe. Set to version-16 (or version-15) to install ERPNext on the site too.
ERPNEXT_BRANCH=

# Image build arguments. Match the GitHub Actions matrix: v15 runs on Python 3.11 / Node 18-20,
# v16 on Python 3.14 / Node 24. Python 3.12 works for both branches.
PYTHON_VERSION=3.12
NODE_VERSION=24

# mariadb:10.6 for Frappe v15, mariadb:11.8 for v16.
MARIADB_IMAGE=mariadb:11.8

SITE_NAME=test_site
DB_ROOT_PASSWORD=root
ADMIN_PASSWORD=admin
BENCH_PORT=8000
